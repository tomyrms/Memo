<UserControl
    x:Class="Memo.App.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <NavigationView
            x:Name="Nav"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsSettingsVisible="False"
            OpenPaneLength="240"
            CompactPaneLength="48"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavSelectionChanged">

            <NavigationView.PaneHeader>
                <StackPanel Margin="12,12,12,16" Spacing="2">
                    <TextBlock
                        FontFamily="{StaticResource MemoDisplayFont}"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource MemoTextBrush}"
                        Text="Memo" />
                    <TextBlock
                        x:Name="LibraryLabel"
                        MaxWidth="190"
                        Style="{StaticResource MemoCaptionTextStyle}"
                        Text="Bibliothèque de démonstration"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Accueil" Tag="home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Bibliothèque" Tag="library">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Pictures" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Albums" Tag="albums">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Récapitulatifs" Tag="recaps">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Calendar" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Recherche" Tag="search">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Find" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Carte" Tag="map">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Map" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Imports" Tag="imports">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Import" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Margin="12,8,12,16" Spacing="4">
                    <Border
                        x:Name="DemoBadge"
                        Padding="8,3"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource MemoAccentSoftBrush}"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource MemoAccentBrush}"
                            Text="Démonstration" />
                    </Border>
                    <TextBlock
                        x:Name="StorageLabel"
                        Style="{StaticResource MemoCaptionTextStyle}"
                        Text="22 souvenirs" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Réglages" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="DemoBar"
                    Grid.Row="0"
                    Margin="32,20,32,0"
                    Title="Mode démonstration"
                    Message="Les souvenirs affichés sont synthétiques. Importez un export pour ouvrir votre bibliothèque."
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button Click="OnImportClick" Content="Importer" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Frame
                    x:Name="ContentFrame"
                    Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</UserControl>


