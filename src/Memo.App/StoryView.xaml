<UserControl
    x:Class="Memo.App.StoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Memo.App.Controls"
    IsTabStop="True"
    KeyDown="OnKeyDown">

    <Grid Background="#0E0D0C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="ProgressPanel"
            Grid.Row="0"
            Margin="20,14,20,0"
            AutomationProperties.Name="Progression de la Story" />

        <Grid
            x:Name="StageHost"
            Grid.Row="1"
            Margin="24,16,24,16">
            <controls:MediaStage x:Name="Stage" AutomationProperties.Name="Zone de lecture du souvenir" />

            <Button
                x:Name="BigPlay" AutomationProperties.Name="Reprendre la lecture"
                Width="64"
                Height="64"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#B3000000"
                BorderThickness="0"
                Click="OnPlayPause"
                CornerRadius="32"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="24"
                    Foreground="White"
                    Glyph="&#xE768;" />
            </Button>

            <Border
                Margin="0,8,10,0"
                Padding="6,2"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#B3000000"
                CornerRadius="3">
                <TextBlock
                    x:Name="Counter"
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="12"
                    Foreground="White" />
            </Border>

            <Border
                x:Name="ExportPanel"
                Margin="24"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#E60E0D0C"
                BorderBrush="#33F4EFE7"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel Width="320" Spacing="10">
                    <TextBlock
                        x:Name="ExportTitle"
                        FontSize="15"
                        Foreground="#F4EFE7"
                        Text="Export de la Story" />
                    <ProgressBar x:Name="ExportProgress" Maximum="100" />
                    <TextBlock
                        x:Name="ExportStatus"
                        FontSize="12"
                        Foreground="#B0A79A"
                        Text="Préparation…" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="32,0,32,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="Caption"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    x:Name="CaptionTitle"
                    FontSize="15"
                    Foreground="#F4EFE7" />
                <TextBlock
                    x:Name="CaptionSubtitle"
                    FontSize="12"
                    Foreground="#B0A79A" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="ExportButton" AutomationProperties.Name="Exporter la Story en vidéo"
                    Width="40"
                    Height="40"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnExport"
                    CornerRadius="20"
                    ToolTipService.ToolTip="Exporter cette Story en vidéo">
                    <FontIcon
                        FontSize="16"
                        Foreground="#F4EFE7"
                        Glyph="&#xE74E;" />
                </Button>
                <Button
                    x:Name="OverlayButton" AutomationProperties.Name="Afficher ou masquer le calque"
                    Width="40"
                    Height="40"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnToggleOverlay"
                    CornerRadius="20"
                    ToolTipService.ToolTip="Afficher ou masquer le calque (O)">
                    <FontIcon
                        FontSize="16"
                        Foreground="#F4EFE7"
                        Glyph="&#xE790;" />
                </Button>
                <Button
                    x:Name="MuteButton" AutomationProperties.Name="Couper ou rétablir le son"
                    Width="40"
                    Height="40"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnToggleMute"
                    CornerRadius="20"
                    ToolTipService.ToolTip="Couper le son (M)">
                    <FontIcon
                        x:Name="MuteIcon"
                        FontSize="16"
                        Foreground="#F4EFE7"
                        Glyph="&#xE767;" />
                </Button>
                <Button
                    Width="40"
                    Height="40"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnPrevious" AutomationProperties.Name="Souvenir précédent"
                    CornerRadius="20"
                    ToolTipService.ToolTip="Précédent (flèche gauche)">
                    <FontIcon
                        FontSize="16"
                        Foreground="#F4EFE7"
                        Glyph="&#xE892;" />
                </Button>
                <Button
                    x:Name="PlayButton" AutomationProperties.Name="Mettre en pause ou reprendre"
                    Width="40"
                    Height="40"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnPlayPause"
                    CornerRadius="20"
                    ToolTipService.ToolTip="Lecture ou pause (espace)">
                    <FontIcon
                        x:Name="PlayIcon"
                        FontSize="16"
                        Foreground="#F4EFE7"
                        Glyph="&#xE769;" />
                </Button>
                <Button
                    Width="40"
                    Height="40"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnNext" AutomationProperties.Name="Souvenir suivant"
                    CornerRadius="20"
                    ToolTipService.ToolTip="Suivant (flèche droite)">
                    <FontIcon
                        FontSize="16"
                        Foreground="#F4EFE7"
                        Glyph="&#xE893;" />
                </Button>
                <Button
                    Width="40"
                    Height="40"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnClose" AutomationProperties.Name="Fermer la lecture"
                    CornerRadius="20"
                    ToolTipService.ToolTip="Fermer (Échap)">
                    <FontIcon
                        FontSize="16"
                        Foreground="#F4EFE7"
                        Glyph="&#xE711;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>





