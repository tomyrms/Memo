<UserControl
    x:Class="Memo.App.StoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Memo.App.Controls"
    IsTabStop="True"
    KeyDown="OnKeyDown"
    RequestedTheme="Dark">

    <UserControl.Resources>
        <!-- Commandes de transport : cible de 44 px, fond discret, focus système conservé. -->
        <Style x:Key="StoryIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#F4EFE7" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>

        <!-- Actions secondaires : libellé explicite, hauteur 36 px, fond très légèrement teinté. -->
        <Style x:Key="StoryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#14F4EFE7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#F4EFE7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>

        <!-- Bascule du calque : l'état coché reste discret pour ne pas concurrencer la photo. -->
        <Style x:Key="StoryToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#F4EFE7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#0E0D0C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="ProgressPanel"
            Grid.Row="0"
            Margin="20,14,20,0"
            AutomationProperties.Name="Progression de la Story" />

        <Grid
            x:Name="StageHost"
            Grid.Row="1"
            Margin="24,16,24,16">
            <controls:MediaStage x:Name="Stage" AutomationProperties.Name="Zone de lecture du souvenir" />

            <Button
                x:Name="BigPlay" AutomationProperties.Name="Reprendre la lecture"
                Width="64"
                Height="64"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#B3000000"
                BorderThickness="0"
                Click="OnPlayPause"
                CornerRadius="32"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="24"
                    Foreground="White"
                    Glyph="&#xE768;" />
            </Button>

        </Grid>

        <Grid
            x:Name="ControlsBar"
            Grid.Row="2"
            Margin="24,0,24,14"
            RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Ligne 1 : légende, position dans la Story et actions secondaires. -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid
                    x:Name="Caption"
                    VerticalAlignment="Center"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="7,2"
                        VerticalAlignment="Center"
                        Background="#1FF4EFE7"
                        CornerRadius="4">
                        <TextBlock
                            x:Name="Counter"
                            AutomationProperties.LiveSetting="Polite"
                            FontSize="12"
                            Foreground="#F4EFE7"
                            Text="1 / 1" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="1">
                        <TextBlock
                            x:Name="CaptionTitle"
                            FontSize="16"
                            Foreground="#F4EFE7"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="CaptionSubtitle"
                            FontSize="12"
                            Foreground="#B0A79A"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <ToggleButton
                        x:Name="OverlayToggle"
                        AutomationProperties.HelpText="Affiche ou masque le calque du souvenir (O)"
                        AutomationProperties.Name="Calque"
                        Click="OnToggleOverlay"
                        IsChecked="True"
                        Style="{StaticResource StoryToggleButtonStyle}"
                        TabIndex="5"
                        ToolTipService.ToolTip="Afficher ou masquer le calque (O)">
                        <ToggleButton.Resources>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#1FF4EFE7" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#29F4EFE7" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#14F4EFE7" />
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#F4EFE7" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#F4EFE7" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#F4EFE7" />
                        </ToggleButton.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                x:Name="OverlayIcon"
                                FontSize="16"
                                Glyph="&#xE790;" />
                            <TextBlock x:Name="OverlayLabel" Text="Calque" />
                        </StackPanel>
                    </ToggleButton>

                    <Button
                        x:Name="SaveMediaButton"
                        AutomationProperties.HelpText="Copie le média source tel quel, sans réencodage, avec un fichier JSON de métadonnées."
                        AutomationProperties.Name="Enregistrer le média courant"
                        Click="OnSaveMedia"
                        Style="{StaticResource StoryActionButtonStyle}"
                        TabIndex="6"
                        ToolTipService.ToolTip="Enregistrer le média source sans réencodage">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="16" Glyph="&#xE74E;" />
                            <TextBlock Text="Enregistrer le média" />
                        </StackPanel>
                    </Button>

                    <ProgressRing
                        x:Name="SaveProgress"
                        Width="16"
                        Height="16"
                        Margin="2,0"
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="Enregistrement du média en cours"
                        Foreground="#E39A5C"
                        IsActive="False"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="ExportButton"
                        AutomationProperties.HelpText="Ouvre la prévisualisation, puis réencode toute la Story en un fichier MP4."
                        AutomationProperties.Name="Exporter la Story en vidéo"
                        Click="OnExport"
                        Style="{StaticResource StoryActionButtonStyle}"
                        TabIndex="7"
                        ToolTipService.ToolTip="Exporter toute la Story en vidéo MP4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="16" Glyph="&#xE714;" />
                            <TextBlock Text="Exporter la Story" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="CloseButton"
                        AutomationProperties.Name="Fermer la lecture"
                        Click="OnClose"
                        Style="{StaticResource StoryIconButtonStyle}"
                        TabIndex="8"
                        ToolTipService.ToolTip="Fermer (Échap)">
                        <FontIcon FontSize="16" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Ligne 2 : transport centré, position à gauche, volume à droite. -->
            <Grid Grid.Row="1" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="TimeText"
                    MinWidth="92"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Position de lecture"
                    FontSize="13"
                    Foreground="#B0A79A"
                    Text="0:00 / 0:00"
                    ToolTipService.ToolTip="Temps courant et durée" />

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button
                        x:Name="PreviousButton"
                        AutomationProperties.Name="Souvenir précédent"
                        Click="OnPrevious"
                        Style="{StaticResource StoryIconButtonStyle}"
                        TabIndex="0"
                        ToolTipService.ToolTip="Précédent (flèche gauche)">
                        <FontIcon FontSize="16" Glyph="&#xE892;" />
                    </Button>

                    <Button
                        x:Name="PlayButton"
                        Width="48"
                        Height="48"
                        Padding="0"
                        AutomationProperties.Name="Mettre en pause ou reprendre"
                        Click="OnPlayPause"
                        CornerRadius="6"
                        Style="{StaticResource AccentButtonStyle}"
                        TabIndex="1"
                        ToolTipService.ToolTip="Lecture ou pause (espace)">
                        <FontIcon
                            x:Name="PlayIcon"
                            FontSize="18"
                            Glyph="&#xE769;" />
                    </Button>

                    <Button
                        x:Name="NextButton"
                        AutomationProperties.Name="Souvenir suivant"
                        Click="OnNext"
                        Style="{StaticResource StoryIconButtonStyle}"
                        TabIndex="2"
                        ToolTipService.ToolTip="Suivant (flèche droite)">
                        <FontIcon FontSize="16" Glyph="&#xE893;" />
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="MuteButton"
                        AutomationProperties.Name="Couper le son"
                        Click="OnToggleMute"
                        Style="{StaticResource StoryIconButtonStyle}"
                        TabIndex="3"
                        ToolTipService.ToolTip="Couper le son (M)">
                        <FontIcon
                            x:Name="MuteIcon"
                            FontSize="16"
                            Glyph="&#xE767;" />
                    </Button>

                    <Slider
                        x:Name="VolumeSlider"
                        Width="120"
                        AutomationProperties.HelpText="Volume de lecture de 0 à 100, conservé pendant la session."
                        AutomationProperties.Name="Volume"
                        LargeChange="10"
                        Maximum="100"
                        Minimum="0"
                        SmallChange="1"
                        StepFrequency="1"
                        TabIndex="4"
                        ValueChanged="OnVolumeChanged" />

                    <TextBlock
                        x:Name="VolumeValue"
                        Width="42"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#B0A79A"
                        Text="100 %"
                        TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Prévisualisation : ordre, durées, calques, audio et options avant tout rendu. -->
        <Border
            x:Name="PreviewPanel"
            Grid.RowSpan="3"
            AutomationProperties.Name="Prévisualisation de l'export"
            Background="#CC000000"
            Visibility="Collapsed">
            <Border
                Width="800"
                Margin="24"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="#F20E0D0C"
                BorderBrush="#3DF4EFE7"
                BorderThickness="1"
                CornerRadius="10"
                RequestedTheme="Dark">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#F4EFE7"
                                Text="Exporter la Story" />
                            <TextBlock
                                x:Name="PreviewSummary"
                                AutomationProperties.LiveSetting="Polite"
                                FontSize="12"
                                Foreground="#B0A79A"
                                Text="Analyse des médias…"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ProgressRing
                            x:Name="PreviewBusy"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="#E39A5C"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        FontSize="12"
                        Foreground="#B0A79A"
                        Text="Cet export réencode toute la Story en un seul MP4. Pour conserver un média original sans réencodage, utilisez « Enregistrer le média » dans le lecteur."
                        TextWrapping="Wrap" />

                    <Grid Grid.Row="2">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PreviewItems" Spacing="6" />
                        </ScrollViewer>
                        <TextBlock
                            x:Name="PreviewEmpty"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#B0A79A"
                            Text="Analyse des médias…"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>

                    <Border
                        Grid.Row="3"
                        Padding="14"
                        Background="#14F4EFE7"
                        CornerRadius="6">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#B0A79A"
                                    Text="Qualité" />
                                <ComboBox
                                    x:Name="PreviewQualityBox"
                                    Width="190"
                                    AutomationProperties.Name="Qualité de l'export"
                                    Background="#1C1917"
                                    BorderBrush="#4DF4EFE7"
                                    Foreground="#F4EFE7"
                                    SelectionChanged="OnPreviewQualityChanged">
                                    <ComboBoxItem Content="1080p · qualité maximale" Tag="1080" IsSelected="True" />
                                    <ComboBoxItem Content="720p · fichier plus léger" Tag="720" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#B0A79A"
                                    Text="Audio des vidéos" />
                                <ToggleSwitch
                                    x:Name="PreviewAudioToggle"
                                    AutomationProperties.Name="Inclure l'audio des vidéos"
                                    Foreground="#F4EFE7"
                                    OffContent="Non"
                                    OnContent="Oui"
                                    Toggled="OnPreviewAudioToggled" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#B0A79A"
                                    Text="Durée des photos" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <NumberBox
                                        x:Name="PreviewPhotoDuration"
                                        Width="105"
                                        AutomationProperties.Name="Durée d'affichage des photos en secondes"
                                        Background="#1C1917"
                                        BorderBrush="#4DF4EFE7"
                                        Foreground="#F4EFE7"
                                        Maximum="30"
                                        Minimum="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        ValueChanged="OnPreviewPhotoDurationChanged" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#B0A79A"
                                        Text="s" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                x:Name="PreviewEstimate"
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontSize="12"
                                Foreground="#F4EFE7"
                                Text="Durée estimée —"
                                TextAlignment="Right"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <InfoBar
                        x:Name="PreviewWarningBar"
                        Grid.Row="4"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Warning"
                        Title="Points à vérifier" />

                    <StackPanel
                        Grid.Row="5"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Padding="16,8"
                            AutomationProperties.Name="Fermer la prévisualisation"
                            Background="#1C1917"
                            BorderBrush="#4DF4EFE7"
                            BorderThickness="1"
                            Click="OnPreviewCancel"
                            Content="Annuler"
                            CornerRadius="6"
                            Foreground="#F4EFE7" />
                        <Button
                            x:Name="PreviewExportButton"
                            Padding="18,8"
                            AutomationProperties.HelpText="Réencode toute la Story et enregistre un fichier MP4."
                            AutomationProperties.Name="Lancer l'export de la Story"
                            Background="#E39A5C"
                            BorderThickness="0"
                            Click="OnPreviewStartExport"
                            Content="Exporter la Story"
                            CornerRadius="6"
                            Foreground="#241407"
                            IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Progression de l'export, avec annulation explicite. -->
        <Border
            x:Name="ExportPanel"
            Grid.RowSpan="3"
            AutomationProperties.Name="Progression de l'export"
            Background="#CC000000"
            Visibility="Collapsed">
            <Border
                Width="380"
                Padding="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F20E0D0C"
                BorderBrush="#3DF4EFE7"
                BorderThickness="1"
                CornerRadius="10"
                RequestedTheme="Dark">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Name="ExportTitle"
                        FontSize="16"
                        Foreground="#F4EFE7"
                        Text="Export de la Story" />
                    <ProgressBar x:Name="ExportProgress" Maximum="100" />
                    <TextBlock
                        x:Name="ExportStatus"
                        AutomationProperties.LiveSetting="Polite"
                        FontSize="12"
                        Foreground="#B0A79A"
                        Text="Préparation…"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="ExportCancelButton"
                        Padding="14,6"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Annuler l'export en cours"
                        Background="#1C1917"
                        BorderBrush="#4DF4EFE7"
                        BorderThickness="1"
                        Click="OnCancelExport"
                        Content="Annuler l'export"
                        CornerRadius="6"
                        Foreground="#F4EFE7" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>





