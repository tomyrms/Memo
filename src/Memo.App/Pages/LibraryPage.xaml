<Page
    x:Class="Memo.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Memo.App.Controls"
    NavigationCacheMode="Required">
    <Grid Padding="32,24,32,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Bibliothèque" Style="{StaticResource MemoTitleTextStyle}" />
                <TextBlock
                    x:Name="CountLabel"
                    Style="{StaticResource MemoSecondaryTextStyle}"
                    Text="0 souvenir" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    x:Name="SelectButton"
                    Click="OnToggleSelection"
                    Content="Sélectionner"
                    Style="{StaticResource MemoSecondaryButtonStyle}" />
                <Button
                    Click="OnImport"
                    Content="Importer"
                    Style="{StaticResource MemoPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Row="0"
                Width="360"
                HorizontalAlignment="Left"
                PlaceholderText="Lieu, date, texte reconnu, identifiant…"
                QueryIcon="Find"
                TextChanged="OnSearchChanged" />
            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                Spacing="8">
                <ComboBox
                    x:Name="TypeFilter"
                    MinWidth="118"
                    SelectionChanged="OnFilterChanged"
                    Style="{StaticResource MemoComboBoxStyle}">
                    <ComboBoxItem Content="Tout" Tag="all" IsSelected="True" />
                    <ComboBoxItem Content="Photos" Tag="photo" />
                    <ComboBoxItem Content="Vidéos" Tag="video" />
                </ComboBox>
                <ComboBox
                    x:Name="YearFilter"
                    MinWidth="132"
                    SelectionChanged="OnFilterChanged"
                    Style="{StaticResource MemoComboBoxStyle}" />
                <ToggleButton
                    x:Name="UndatedToggle"
                    Padding="12,6"
                    Click="OnFilterChanged"
                    Content="Date inconnue" />
                <ToggleButton
                    x:Name="MissingToggle"
                    Padding="12,6"
                    Click="OnFilterChanged"
                    Content="À compléter" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <GridView
                x:Name="Grid"
                IsItemClickEnabled="True"
                ItemClick="OnItemClick"
                RightTapped="OnGridRightTapped"
                SelectionMode="None"
                ShowsScrollingPlaceholders="True">
                <GridView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="4,16,0,8"
                                    Style="{StaticResource MemoSectionTextStyle}"
                                    Text="{Binding Key}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </GridView.GroupStyle>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <controls:MemoryTile Card="{Binding}" />
                    </DataTemplate>
                </GridView.ItemTemplate>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,8,8" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </GridView.ItemContainerStyle>
            </GridView>

            <StackPanel
                x:Name="EmptyPanel"
                MaxWidth="520"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock Text="Aucun souvenir ne correspond" Style="{StaticResource MemoSubtitleTextStyle}" />
                <TextBlock
                    Style="{StaticResource MemoSecondaryTextStyle}"
                    Text="Modifiez le filtre ou importez une archive supplémentaire. Les médias sans date restent visibles via « Date inconnue »." />
                <Button
                    Click="OnClearFilters"
                    Content="Tout afficher"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0"
                    Style="{StaticResource MemoSecondaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border
            x:Name="SelectionBar"
            Grid.Row="2"
            VerticalAlignment="Bottom"
            Padding="12"
            Background="{ThemeResource MemoSurfaceBrush}"
            BorderBrush="{ThemeResource MemoBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="SelectionLabel"
                    VerticalAlignment="Center"
                    Style="{StaticResource MemoBodyTextStyle}" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button Click="OnFavoriteSelection" Content="Favori" Style="{StaticResource MemoQuietButtonStyle}" />
                    <Button Click="OnExcludeSelection" Content="Masquer" Style="{StaticResource MemoQuietButtonStyle}" />
                    <Button Click="OnAddToAlbum" Content="Album" Style="{StaticResource MemoQuietButtonStyle}" />
                    <Button Click="OnToggleSelection" Content="Terminer" Style="{StaticResource MemoSecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>



