<Page
    x:Class="Memo.App.Pages.ImportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="980"
            Margin="32,24,32,32"
            HorizontalAlignment="Stretch"
            Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Imports" Style="{StaticResource MemoTitleTextStyle}" />
                <TextBlock
                    x:Name="IntroText"
                    Style="{StaticResource MemoSecondaryTextStyle}"
                    Text="Ajoutez les ZIP d'un même export, dans l'ordre que vous voulez. Les archives suivantes complètent la bibliothèque sans effacer vos choix." />
            </StackPanel>

            <InfoBar
                x:Name="Notice"
                IsClosable="True"
                IsOpen="False" />

            <!-- Premier lancement : sans bibliothèque, l'écran ne propose pas un
                 import impossible mais les deux actions qui débloquent le parcours. -->
            <Border
                x:Name="NoLibraryPanel"
                Style="{StaticResource MemoCardBorderStyle}"
                Padding="16"
                Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <TextBlock Text="Aucune bibliothèque ouverte" Style="{StaticResource MemoSubtitleTextStyle}" />
                    <TextBlock
                        Style="{StaticResource MemoSecondaryTextStyle}"
                        Text="Memo range les souvenirs dans un dossier de votre ordinateur. Créez une bibliothèque pour commencer, ou ouvrez celle que vous utilisez déjà. Vous pourrez ensuite y ajouter vos archives." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Click="OnCreateLibrary"
                            Content="Créer une bibliothèque"
                            Style="{StaticResource MemoPrimaryButtonStyle}" />
                        <Button
                            Click="OnOpenLibrary"
                            Content="Ouvrir une bibliothèque"
                            Style="{StaticResource MemoSecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                x:Name="SpacePanel"
                Style="{StaticResource MemoCardBorderStyle}"
                Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Espace source" Style="{StaticResource MemoSectionTextStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="SpaceBox"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="OnSpaceChanged"
                            Style="{StaticResource MemoComboBoxStyle}" />
                        <Button
                            Grid.Column="1"
                            Click="OnNewSpace"
                            Content="Nouvel espace"
                            Style="{StaticResource MemoSecondaryButtonStyle}" />
                    </Grid>
                    <TextBlock
                        Style="{StaticResource MemoCaptionTextStyle}"
                        Text="Un espace sépare les archives de comptes différents. Un même identifiant n'est jamais fusionné entre deux espaces." />
                </StackPanel>
            </Border>

            <Border
                x:Name="LibraryPanel"
                Style="{StaticResource MemoCardBorderStyle}"
                Padding="16"
                Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Bibliothèque" Style="{StaticResource MemoSectionTextStyle}" />
                        <TextBlock
                            x:Name="LibraryPathText"
                            Style="{StaticResource MemoCaptionTextStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Click="OnChangeDisk"
                        Content="Choisir un autre disque…"
                        Style="{StaticResource MemoSecondaryButtonStyle}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border
                x:Name="ArchivePanel"
                AllowDrop="True"
                Background="{ThemeResource MemoSurfaceBrush}"
                BorderBrush="{ThemeResource MemoBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                DragOver="OnDragOver"
                Drop="OnDrop"
                Padding="24">
                <StackPanel Spacing="10">
                    <FontIcon
                        FontSize="28"
                        Foreground="{ThemeResource MemoTextSecondaryBrush}"
                        Glyph="&#xE896;"
                        HorizontalAlignment="Left" />
                    <TextBlock Text="Archives à importer" Style="{StaticResource MemoSectionTextStyle}" />
                    <TextBlock
                        Style="{StaticResource MemoSecondaryTextStyle}"
                        Text="Sélectionnez plusieurs ZIP, un dossier de ZIP ou un export déjà extrait. Les médias des conversations restent hors périmètre." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Click="OnPickArchives"
                            Content="Choisir des archives"
                            Style="{StaticResource MemoPrimaryButtonStyle}" />
                        <Button
                            Click="OnPickFolder"
                            Content="Choisir un dossier"
                            Style="{StaticResource MemoSecondaryButtonStyle}" />
                        <Button
                            Click="OnClearSelection"
                            Content="Vider"
                            Style="{StaticResource MemoQuietButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                x:Name="SelectionPanel"
                Style="{StaticResource MemoCardBorderStyle}"
                Padding="16"
                Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="SelectionTitle" Style="{StaticResource MemoSectionTextStyle}" />
                    <ListView
                        x:Name="SelectionList"
                        MaxHeight="180"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource MemoBodyTextStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource MemoCaptionTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="SelectionSummary"
                        Style="{StaticResource MemoSecondaryTextStyle}" />
                    <TextBlock
                        x:Name="SelectionWarning"
                        Foreground="{ThemeResource MemoDangerBrush}"
                        Style="{StaticResource MemoCaptionTextStyle}"
                        Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="ImportButton"
                            Click="OnImport"
                            Content="Importer"
                            Style="{StaticResource MemoPrimaryButtonStyle}" />
                        <Button
                            Click="OnClearSelection"
                            Content="Annuler la sélection"
                            Style="{StaticResource MemoQuietButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                x:Name="ProgressPanel"
                Style="{StaticResource MemoCardBorderStyle}"
                Padding="16"
                Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ProgressTitle" Style="{StaticResource MemoSectionTextStyle}" Text="Import en cours" />
                    <ProgressBar x:Name="ProgressBar" Maximum="1" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressText" Style="{StaticResource MemoSecondaryTextStyle}" />
                        <Button
                            Grid.Column="1"
                            Click="OnCancel"
                            Content="Annuler"
                            Style="{StaticResource MemoQuietButtonStyle}" />
                    </Grid>
                    <TextBlock
                        Style="{StaticResource MemoCaptionTextStyle}"
                        Text="L'import peut être interrompu : les éléments déjà validés restent disponibles et un nouvel import reprend sans doublon." />
                </StackPanel>
            </Border>

            <StackPanel x:Name="ResultPanel" Spacing="12" Visibility="Collapsed">
                <TextBlock Text="Bilan de l'import" Style="{StaticResource MemoSectionTextStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource MemoCardBorderStyle}" Padding="12">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="StatMemories" Style="{StaticResource MemoSubtitleTextStyle}" Text="0" />
                            <TextBlock Text="souvenirs" Style="{StaticResource MemoCaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MemoCardBorderStyle}" Padding="12">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="StatMedia" Style="{StaticResource MemoSubtitleTextStyle}" Text="0" />
                            <TextBlock Text="médias" Style="{StaticResource MemoCaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MemoCardBorderStyle}" Padding="12">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="StatOverlays" Style="{StaticResource MemoSubtitleTextStyle}" Text="0" />
                            <TextBlock Text="calques" Style="{StaticResource MemoCaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource MemoCardBorderStyle}" Padding="12">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="StatMissing" Style="{StaticResource MemoSubtitleTextStyle}" Text="0" />
                            <TextBlock Text="à compléter" Style="{StaticResource MemoCaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock
                    x:Name="ResultNote"
                    Style="{StaticResource MemoSecondaryTextStyle}" />
                <ListView
                    x:Name="Diagnostics"
                    MaxHeight="220"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="0,4" Spacing="1">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource MemoBodyTextStyle}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MemoCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Imports précédents" Style="{StaticResource MemoSectionTextStyle}" />
                <ListView
                    x:Name="History"
                    MaxHeight="260"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="0,6" Spacing="1">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource MemoBodyTextStyle}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MemoCaptionTextStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="HistoryEmpty"
                    Style="{StaticResource MemoSecondaryTextStyle}"
                    Text="Aucun import enregistré dans cette session." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
