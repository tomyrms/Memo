<Page
    x:Class="Memo.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="920" Margin="32,24,32,32" HorizontalAlignment="Left" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Réglages" Style="{StaticResource MemoTitleTextStyle}" />
                <TextBlock
                    Style="{StaticResource MemoSecondaryTextStyle}"
                    Text="La bibliothèque, les dates, la lecture et les analyses facultatives. Tout reste local." />
            </StackPanel>

            <Border Style="{StaticResource MemoCardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Bibliothèque" Style="{StaticResource MemoSectionTextStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="LibraryPath" Style="{StaticResource MemoBodyTextStyle}" Text="Aucune bibliothèque ouverte" />
                            <TextBlock x:Name="LibraryStats" Style="{StaticResource MemoCaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Click="OnOpenLibrary" Content="Ouvrir" Style="{StaticResource MemoSecondaryButtonStyle}" />
                            <Button Click="OnCreateLibrary" Content="Créer" Style="{StaticResource MemoPrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        Style="{StaticResource MemoCaptionTextStyle}"
                        Text="Les fichiers importés ne sont jamais réécrits. Une bibliothèque peut être déplacée puis rouverte depuis son nouveau dossier." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MemoCardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Apparence" Style="{StaticResource MemoSectionTextStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Thème" Style="{StaticResource MemoBodyTextStyle}" VerticalAlignment="Center" />
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" MaxWidth="220" HorizontalAlignment="Left" SelectionChanged="OnThemeChanged" Style="{StaticResource MemoComboBoxStyle}">
                            <ComboBoxItem Content="Système" Tag="System" IsSelected="True" />
                            <ComboBoxItem Content="Clair" Tag="Light" />
                            <ComboBoxItem Content="Sombre" Tag="Dark" />
                        </ComboBox>
                    </Grid>
                    <ToggleSwitch
                        x:Name="MotionSwitch"
                        Header="Réduire les animations"
                        OffContent="Animations système"
                        OnContent="Réduites"
                        Toggled="OnMotionChanged" />
                    <TextBlock
                        Style="{StaticResource MemoCaptionTextStyle}"
                        Text="Le réglage Windows de réduction des animations reste prioritaire." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MemoCardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Lecture" Style="{StaticResource MemoSectionTextStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Durée d'une photo" Style="{StaticResource MemoBodyTextStyle}" VerticalAlignment="Center" />
                        <NumberBox
                            x:Name="PhotoDuration"
                            Grid.Column="1"
                            Width="120"
                            HorizontalAlignment="Left"
                            Minimum="1"
                            Maximum="20"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="OnPhotoDurationChanged" />
                    </Grid>
                    <ToggleSwitch x:Name="AutoplaySwitch" Header="Lire les vidéos automatiquement dans une Story" Toggled="OnPlaybackChanged" />
                    <ToggleSwitch x:Name="AudioSwitch" Header="Activer le son" Toggled="OnPlaybackChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MemoCardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Dates et fuseau" Style="{StaticResource MemoSectionTextStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Fuseau de classement" Style="{StaticResource MemoBodyTextStyle}" VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="TimeZoneBox"
                            Grid.Column="1"
                            MaxWidth="360"
                            HorizontalAlignment="Left"
                            SelectionChanged="OnTimeZoneChanged"
                            Style="{StaticResource MemoComboBoxStyle}" />
                    </Grid>
                    <TextBlock
                        Style="{StaticResource MemoCaptionTextStyle}"
                        Text="Le jour d'un souvenir est calculé dans ce fuseau, sans modifier l'instant d'origine. Changer de fuseau peut déplacer un souvenir d'un jour." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MemoCardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Rappels" Style="{StaticResource MemoSectionTextStyle}" />
                    <ToggleSwitch x:Name="RemindersSwitch" Header="Rappel quotidien" Toggled="OnRemindersChanged" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Heure" Style="{StaticResource MemoBodyTextStyle}" VerticalAlignment="Center" />
                        <TimePicker x:Name="ReminderTime" Grid.Column="1" ClockIdentifier="24HourClock" SelectedTimeChanged="OnReminderTimeChanged" />
                    </Grid>
                    <ToggleSwitch x:Name="DiscreetSwitch" Header="Notification discrète (sans miniature ni nom)" Toggled="OnDiscreetChanged" />
                    <Border
                        Background="{ThemeResource MemoPhotoPlaceholderBrush}"
                        CornerRadius="4"
                        Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="ReminderTaskState"
                                Style="{StaticResource MemoBodyTextStyle}"
                                Text="Vérification de la tâche planifiée…"
                                TextWrapping="Wrap" />
                            <TextBlock x:Name="ReminderNextRun" Style="{StaticResource MemoCaptionTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ReminderLastRun" Style="{StaticResource MemoCaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="TestReminderButton"
                            Click="OnTestReminder"
                            Content="Tester maintenant"
                            Style="{StaticResource MemoSecondaryButtonStyle}" />
                        <TextBlock
                            x:Name="ReminderStatus"
                            VerticalAlignment="Center"
                            Style="{StaticResource MemoCaptionTextStyle}" />
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource MemoCaptionTextStyle}"
                        Text="Aucun rappel n'est activé par défaut. Quand la fenêtre est fermée, Windows lance brièvement Memo à l'heure choisie pour afficher la notification, puis le processus se termine : aucune fenêtre ne s'ouvre et Memo ne démarre pas avec Windows. Un clic sur la notification ouvre « Ce jour-là » ; si Memo est déjà ouvert, sa fenêtre est ramenée au premier plan. Le test n'envoie qu'une notification immédiate et ne consomme pas le rappel du jour." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MemoCardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Analyses locales facultatives" Style="{StaticResource MemoSectionTextStyle}" />
                    <ToggleSwitch x:Name="OcrSwitch" Header="Reconnaître le texte des images (OCR)" Toggled="OnAnalysisChanged" />
                    <ToggleSwitch x:Name="FacesSwitch" Header="Détecter et regrouper les visages" Toggled="OnAnalysisChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="AnalyzeButton"
                            Click="OnAnalyze"
                            Content="Analyser maintenant"
                            Style="{StaticResource MemoSecondaryButtonStyle}" />
                        <Button
                            x:Name="CancelAnalysisButton"
                            Click="OnCancelAnalysis"
                            Content="Annuler"
                            Style="{StaticResource MemoQuietButtonStyle}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="AnalysisStatus"
                            VerticalAlignment="Center"
                            Style="{StaticResource MemoCaptionTextStyle}" />
                    </StackPanel>
                    <ProgressBar x:Name="AnalysisProgress" Maximum="1" Visibility="Collapsed" />
                    <TextBlock
                        Style="{StaticResource MemoCaptionTextStyle}"
                        Text="Ces traitements s'exécutent sur ce PC. Aucun média n'est envoyé à un service distant. Les résultats peuvent être supprimés sans effacer les souvenirs." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MemoCardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Données d'analyse" Style="{StaticResource MemoSectionTextStyle}" />
                    <TextBlock
                        x:Name="AnalysisDataStats"
                        Style="{StaticResource MemoCaptionTextStyle}"
                        Text="Ouvrez une bibliothèque pour consulter les données d'analyse." />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Textes reconnus (OCR)" Style="{StaticResource MemoBodyTextStyle}" />
                            <TextBlock
                                Style="{StaticResource MemoCaptionTextStyle}"
                                Text="Alimentent la recherche texte. Supprimables et recalculables à volonté." />
                        </StackPanel>
                        <Button
                            x:Name="ClearOcrButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OnClearOcr"
                            Content="Supprimer les textes"
                            Foreground="{ThemeResource MemoDangerBrush}"
                            Style="{StaticResource MemoSecondaryButtonStyle}" />
                    </Grid>

                    <Border Style="{StaticResource MemoDividerStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Empreintes visuelles" Style="{StaticResource MemoBodyTextStyle}" />
                            <TextBlock
                                Style="{StaticResource MemoCaptionTextStyle}"
                                Text="Servent à la recherche par ressemblance. Aucune image n'est conservée par cette empreinte." />
                        </StackPanel>
                        <Button
                            x:Name="ClearVisualButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OnClearVisual"
                            Content="Supprimer les empreintes"
                            Foreground="{ThemeResource MemoDangerBrush}"
                            Style="{StaticResource MemoSecondaryButtonStyle}" />
                    </Grid>

                    <Border Style="{StaticResource MemoDividerStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Visages et groupes de personnes" Style="{StaticResource MemoBodyTextStyle}" />
                            <TextBlock
                                Style="{StaticResource MemoCaptionTextStyle}"
                                Text="Détections et groupes proposés dans l'onglet Personnes, y compris les noms saisis." />
                        </StackPanel>
                        <Button
                            x:Name="ClearFacesButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OnClearFaces"
                            Content="Supprimer les visages"
                            Foreground="{ThemeResource MemoDangerBrush}"
                            Style="{StaticResource MemoSecondaryButtonStyle}" />
                    </Grid>

                    <TextBlock
                        Style="{StaticResource MemoCaptionTextStyle}"
                        Text="Ces suppressions ne touchent ni les souvenirs, ni les médias, ni les albums, ni les dates corrigées. Une nouvelle analyse peut recréer les données ; les noms de groupes saisis ne sont pas restaurés." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MemoCardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Sauvegarde et restauration" Style="{StaticResource MemoSectionTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="BackupButton"
                            Click="OnBackup"
                            Content="Sauvegarder la bibliothèque"
                            Style="{StaticResource MemoSecondaryButtonStyle}" />
                        <Button
                            x:Name="RestoreButton"
                            Click="OnRestore"
                            Content="Restaurer une sauvegarde"
                            Style="{StaticResource MemoSecondaryButtonStyle}" />
                    </StackPanel>
                    <StackPanel
                        x:Name="BackupProgressPanel"
                        Spacing="6"
                        Visibility="Collapsed">
                        <ProgressBar
                            x:Name="BackupProgressBar"
                            Maximum="100"
                            Value="0" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="BackupStatus"
                                VerticalAlignment="Center"
                                Style="{StaticResource MemoCaptionTextStyle}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="CancelBackupButton"
                                Grid.Column="1"
                                Click="OnCancelBackup"
                                Content="Annuler"
                                Style="{StaticResource MemoQuietButtonStyle}" />
                        </Grid>
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource MemoCaptionTextStyle}"
                        Text="La sauvegarde contient le catalogue, les médias sources, les albums, les favoris, les exclusions et les dates corrigées. Les caches reconstructibles sont exclus. Une sauvegarde ou une restauration annulée ne laisse aucun fichier partiel sous son nom final." />
                </StackPanel>
            </Border>

            <Border
                x:Name="ThumbnailCard"
                Style="{StaticResource MemoCardBorderStyle}"
                Padding="16"
                Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="Aperçus" Style="{StaticResource MemoSectionTextStyle}" />
                    <TextBlock
                        x:Name="ThumbnailStatus"
                        Style="{StaticResource MemoCaptionTextStyle}"
                        TextWrapping="Wrap" />
                    <ProgressBar
                        x:Name="ThumbnailProgressBar"
                        Maximum="1"
                        Value="0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="CancelThumbnailsButton"
                            Click="OnCancelThumbnails"
                            Content="Annuler la reconstruction"
                            Style="{StaticResource MemoQuietButtonStyle}" />
                        <Button
                            x:Name="RetryThumbnailsButton"
                            Click="OnRetryThumbnails"
                            Content="Reprendre"
                            Style="{StaticResource MemoSecondaryButtonStyle}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MemoCardBorderStyle}" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="À propos" Style="{StaticResource MemoSectionTextStyle}" />
                    <TextBlock x:Name="VersionLabel" Style="{StaticResource MemoBodyTextStyle}" />
                    <TextBlock
                        Style="{StaticResource MemoCaptionTextStyle}"
                        Text="Memo est un projet indépendant, sans affiliation avec Snapchat ou Snap. VideoLAN LibVLC est distribué sous LGPL 2.1 ; SkiaSharp sous licence MIT." />
                    <HyperlinkButton Click="OnOpenLicenses" Content="Licences et composants" />
                </StackPanel>
            </Border>

            <InfoBar
                x:Name="Notice"
                IsClosable="True"
                IsOpen="False" />
        </StackPanel>
    </ScrollViewer>
</Page>

