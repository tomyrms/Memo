<Page
    x:Class="Memo.App.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Memo.App.Controls"
    NavigationCacheMode="Required">
    <Grid Padding="32,24,32,32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Recherche" Style="{StaticResource MemoTitleTextStyle}" />
            <TextBlock
                Style="{StaticResource MemoSecondaryTextStyle}"
                Text="Retrouver par texte, par personne ou par ressemblance. Les analyses restent locales." />
        </StackPanel>

        <SelectorBar x:Name="Modes" Grid.Row="1" SelectionChanged="OnModeChanged">
            <SelectorBarItem Text="Texte" IsSelected="True" />
            <SelectorBarItem Text="Personnes" />
            <SelectorBarItem Text="Ressemblance" />
        </SelectorBar>

        <Grid Grid.Row="2">
            <Grid x:Name="TextPanel" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <AutoSuggestBox
                    x:Name="Query"
                    Width="360"
                    HorizontalAlignment="Left"
                    PlaceholderText="Lieu, date, texte reconnu…"
                    QueryIcon="Find"
                    TextChanged="OnQueryChanged" />
                <TextBlock
                    x:Name="ResultCount"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource MemoCaptionTextStyle}" />
                <GridView
                    x:Name="Results"
                    Grid.Row="1"
                    IsItemClickEnabled="True"
                    ItemClick="OnItemClick"
                    SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <controls:MemoryTile Card="{Binding}" ShowDate="True" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
                <TextBlock
                    x:Name="EmptyText"
                    Grid.Row="1"
                    VerticalAlignment="Top"
                    Style="{StaticResource MemoSecondaryTextStyle}"
                    Text="Saisissez un mot pour chercher dans les lieux, les dates et les textes reconnus."
                    Visibility="Collapsed" />
            </Grid>

            <Grid x:Name="PeoplePanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar
                    IsOpen="True"
                    Severity="Informational"
                    Title="Fonction facultative"
                    Message="Les groupes de visages sont calculés localement, sans nom automatique. Ils restent corrigeables et supprimables." />
                <StackPanel Grid.Row="1" Spacing="12">
                    <TextBlock Text="Groupes proposés" Style="{StaticResource MemoSectionTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Click="OnPerson1" Style="{StaticResource MemoTileButtonStyle}">
                            <StackPanel Width="200" Spacing="8">
                                <Border Height="140" Background="{ThemeResource MemoPhotoPlaceholderBrush}" CornerRadius="4">
                                    <Image Source="ms-appx:///Assets/Demo/demo02.jpg" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="Personne 1" Style="{StaticResource MemoBodyTextStyle}" />
                                <TextBlock Text="8 souvenirs · à confirmer" Style="{StaticResource MemoCaptionTextStyle}" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnPerson2" Style="{StaticResource MemoTileButtonStyle}">
                            <StackPanel Width="200" Spacing="8">
                                <Border Height="140" Background="{ThemeResource MemoPhotoPlaceholderBrush}" CornerRadius="4">
                                    <Image Source="ms-appx:///Assets/Demo/demo09.jpg" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="Personne 2" Style="{StaticResource MemoBodyTextStyle}" />
                                <TextBlock Text="5 souvenirs · à confirmer" Style="{StaticResource MemoCaptionTextStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid x:Name="VisualPanel" Visibility="Collapsed" RowSpacing="12">
                <InfoBar
                    IsOpen="True"
                    Severity="Informational"
                    Title="Recherche visuelle non activée"
                    Message="L'analyse locale n'est pas encore lancée sur cette bibliothèque. Aucun résultat n'est simulé." />
                <StackPanel Spacing="8" VerticalAlignment="Top" Margin="0,64,0,0">
                    <TextBlock Text="Activer l'analyse locale" Style="{StaticResource MemoSectionTextStyle}" />
                    <TextBlock
                        MaxWidth="620"
                        HorizontalAlignment="Left"
                        Style="{StaticResource MemoSecondaryTextStyle}"
                        Text="Memo peut calculer une empreinte perceptuelle de chaque miniature pour retrouver des images proches. Le calcul se fait sur ce PC et peut être supprimé à tout moment." />
                    <Button
                        Click="OnEnableVisual"
                        Content="Activer et analyser"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"
                        Style="{StaticResource MemoPrimaryButtonStyle}" />
                    <TextBlock
                        x:Name="VisualStatus"
                        Style="{StaticResource MemoCaptionTextStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>



