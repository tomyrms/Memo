<Page
    x:Class="Memo.App.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Memo.App.Controls"
    NavigationCacheMode="Required">
    <Grid Padding="32,24,32,32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Recherche" Style="{StaticResource MemoTitleTextStyle}" />
            <TextBlock
                Style="{StaticResource MemoSecondaryTextStyle}"
                Text="Retrouver par texte, par personne ou par ressemblance. Les analyses restent locales." />
        </StackPanel>

        <SelectorBar x:Name="Modes" Grid.Row="1" SelectionChanged="OnModeChanged">
            <SelectorBarItem Text="Texte" IsSelected="True" />
            <SelectorBarItem Text="Personnes" />
            <SelectorBarItem Text="Ressemblance" />
        </SelectorBar>

        <Grid Grid.Row="2">
            <Grid x:Name="TextPanel" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <AutoSuggestBox
                    x:Name="Query"
                    Width="360"
                    HorizontalAlignment="Left"
                    PlaceholderText="Lieu, date, texte reconnu, identifiant…"
                    QueryIcon="Find"
                    TextChanged="OnQueryChanged" />
                <TextBlock
                    x:Name="ResultCount"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource MemoCaptionTextStyle}" />
                <GridView
                    x:Name="Results"
                    Grid.Row="1"
                    IsItemClickEnabled="True"
                    ItemClick="OnItemClick"
                    SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <controls:MemoryTile Card="{Binding}" ShowDate="True" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
                <TextBlock
                    x:Name="EmptyText"
                    Grid.Row="1"
                    VerticalAlignment="Top"
                    Style="{StaticResource MemoSecondaryTextStyle}"
                    Text="Saisissez un mot pour chercher dans les lieux, les dates et les textes reconnus."
                    Visibility="Collapsed" />
            </Grid>

            <Grid x:Name="PeoplePanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar
                    IsOpen="True"
                    Severity="Informational"
                    Title="Fonction facultative"
                    Message="Les groupes de visages sont calculés localement, sans nom automatique. Restent des propositions : renommez-les, fusionnez-les ou supprimez-les librement." />
                <StackPanel Grid.Row="1" Spacing="12">
                    <TextBlock x:Name="PeopleStatus" Style="{StaticResource MemoSecondaryTextStyle}" />
                    <InfoBar x:Name="PeopleNotice" IsClosable="True" IsOpen="False" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <StackPanel x:Name="PeopleList" Orientation="Horizontal" Spacing="12" />
                    </ScrollViewer>
                </StackPanel>
            </Grid>

            <Grid x:Name="VisualPanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar
                    IsOpen="True"
                    Severity="Informational"
                    Title="Recherche par ressemblance"
                    Message="Les empreintes sont calculées localement, à partir des miniatures. Aucun média n'est envoyé à l'extérieur." />
                <StackPanel
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ComboBox
                        x:Name="ReferenceBox"
                        MinWidth="280"
                        Style="{StaticResource MemoComboBoxStyle}" />
                    <Button
                        Click="OnFindSimilar"
                        Content="Trouver des similaires"
                        Style="{StaticResource MemoSecondaryButtonStyle}" />
                    <TextBlock
                        x:Name="VisualStatus"
                        VerticalAlignment="Center"
                        Style="{StaticResource MemoCaptionTextStyle}" />
                </StackPanel>
                <GridView
                    x:Name="SimilarGrid"
                    Grid.Row="2"
                    IsItemClickEnabled="True"
                    ItemClick="OnSimilarClick"
                    SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <controls:MemoryTile Card="{Binding}" ShowDate="True" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
            </Grid>
        </Grid>
    </Grid>
</Page>



