<Page
    x:Class="Memo.App.Pages.MapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Memo.App.Controls"
    NavigationCacheMode="Required">
    <Grid Padding="32,24,32,32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Carte" Style="{StaticResource MemoTitleTextStyle}" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource MemoSecondaryTextStyle}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Click="OnGoLibrary"
                Content="Ouvrir la bibliothèque"
                Style="{StaticResource MemoSecondaryButtonStyle}"
                VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource MemoSurfaceAltBrush}"
                BorderBrush="{ThemeResource MemoBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <controls:MemoMap x:Name="Map" />
            </Border>

            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="Souvenirs situés" Style="{StaticResource MemoSectionTextStyle}" />
                    <TextBlock
                        x:Name="CountLabel"
                        Style="{StaticResource MemoCaptionTextStyle}" />
                </StackPanel>
                <ListView
                    x:Name="Places"
                    Grid.Row="1"
                    SelectionChanged="OnPlaceSelected"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="0,6" Spacing="1">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource MemoBodyTextStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Date}" Style="{StaticResource MemoCaptionTextStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    x:Name="Empty"
                    Grid.Row="1"
                    Spacing="6"
                    Visibility="Collapsed">
                    <TextBlock Text="Aucun lieu renseigné" Style="{StaticResource MemoBodyTextStyle}" />
                    <TextBlock
                        Style="{StaticResource MemoSecondaryTextStyle}"
                        Text="Les coordonnées ne sont pas inventées à partir de l'historique du compte. Ajoutez un lieu depuis la fiche d'un souvenir." />
                </StackPanel>

                <Expander
                    x:Name="EventPlacesExpander"
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    IsExpanded="False"
                    Visibility="Collapsed">
                    <Expander.Header>
                        <TextBlock
                            Style="{StaticResource MemoSectionTextStyle}"
                            Text="Lieux des événements proposés" />
                    </Expander.Header>
                    <StackPanel
                        x:Name="EventPlaces"
                        Margin="0,6,0,0"
                        Spacing="4" />
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</Page>
