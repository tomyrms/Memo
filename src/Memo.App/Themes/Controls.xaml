<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CornerRadius x:Key="MemoControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="MemoCardCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="MemoDialogCornerRadius">8</CornerRadius>
    <Thickness x:Key="MemoPagePadding">32,24,32,32</Thickness>
    <Thickness x:Key="MemoCardPadding">16</Thickness>

    <Style x:Key="MemoPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource MemoControlCornerRadius}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontFamily" Value="{StaticResource MemoTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style x:Key="MemoSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource MemoControlCornerRadius}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontFamily" Value="{StaticResource MemoTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style x:Key="MemoQuietButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource MemoControlCornerRadius}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontFamily" Value="{StaticResource MemoTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style x:Key="MemoTileButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource MemoCardCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="MemoCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MemoSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MemoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MemoCardCornerRadius}" />
    </Style>

    <Style x:Key="MemoDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource MemoBorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="MemoFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MemoSecondaryTextStyle}">
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="MemoTextBoxStyle" TargetType="TextBox">
        <Setter Property="CornerRadius" Value="{StaticResource MemoControlCornerRadius}" />
        <Setter Property="FontFamily" Value="{StaticResource MemoTextFont}" />
    </Style>

    <Style x:Key="MemoComboBoxStyle" TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="{StaticResource MemoControlCornerRadius}" />
        <Setter Property="FontFamily" Value="{StaticResource MemoTextFont}" />
    </Style>

    <Style x:Key="MemoNavigationViewStyle" TargetType="NavigationView">
        <Setter Property="IsBackButtonVisible" Value="Collapsed" />
        <Setter Property="IsSettingsVisible" Value="False" />
        <Setter Property="PaneDisplayMode" Value="Left" />
        <Setter Property="OpenPaneLength" Value="240" />
        <Setter Property="CompactPaneLength" Value="48" />
        <Setter Property="IsPaneToggleButtonVisible" Value="True" />
        <Setter Property="SelectionFollowsFocus" Value="Disabled" />
    </Style>

</ResourceDictionary>
